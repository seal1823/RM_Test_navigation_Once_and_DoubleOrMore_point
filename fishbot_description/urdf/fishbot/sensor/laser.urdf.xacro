<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>
    <xacro:macro name="laser_xacro" params="xyz">
        <link name="laser_cylinder_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
                <!-- 材质和颜色 -->
                <material name="black">
                    <!-- a表示透明度 -->
                    <color rgba="0.0 0.0 0.0 1.0"/>   
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>
                </geometry>
                <!-- 材质和颜色 -->
                <material name="black">
                    <!-- a表示透明度 -->
                    <color rgba="0.0 0.0 0.0 1.0"/>   
                </material>
            </collision>

            <xacro:cylinder_inertia m="0.01" r="0.01" h="0.10" />
        </link>

        <link name="laser_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <!-- 材质和颜色 -->
                <material name="black">
                    <!-- a表示透明度 -->
                    <color rgba="0.0 0.0 0.0 1.0"/>   
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <!-- 几何形状 -->
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>
                </geometry>
                <!-- 材质和颜色 -->
                <material name="black">
                    <!-- a表示透明度 -->
                    <color rgba="0.0 0.0 0.0 1.0"/>   
                </material>
            </collision>

            <xacro:cylinder_inertia m="0.03" r="0.02" h="0.02" />
        </link>

        <!-- 机器人的关节，用于连接机器人的部件 -->
        <joint name="laser_joint" type="fixed">
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
        </joint>

        <joint name="laser_cylinder_joint" type="fixed">
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
        </joint>

        <gazebo reference="laser_cylinder_link">
            <material>Gazebo/Black</material>
        </gazebo>
        <gazebo reference="laser_link">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

</robot>